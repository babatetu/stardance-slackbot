{
  "display_information": {
    "name": "AstroBot - NASA Mission Control",
    "description": "Interactive NASA space telemetry, Mars exploration photos, and space trivia bot for Hack Club Stardance.",
    "background_color": "#0d1117"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "AstroBot",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/astro-apod",
        "description": "Fetch NASA Astronomy Picture of the Day (APOD)",
        "usage_hint": "[YYYY-MM-DD | random]",
        "should_escape": false
      },
      {
        "command": "/astro-neo",
        "description": "Real-time NASA Asteroid Radar (Near-Earth Objects)",
        "usage_hint": "Scans asteroids passing today",
        "should_escape": false
      },
      {
        "command": "/astro-mars",
        "description": "NASA Mars Rover exploration photos (Curiosity/Perseverance)",
        "usage_hint": "[curiosity|perseverance] [sol number]",
        "should_escape": false
      },
      {
        "command": "/astro-iss",
        "description": "Live ISS coordinates, velocity & active astronauts in orbit",
        "usage_hint": "Shows orbital telemetry",
        "should_escape": false
      },
      {
        "command": "/astro-quiz",
        "description": "Play interactive NASA Space Trivia with live scoring buttons",
        "usage_hint": "Triggers space quiz in channel",
        "should_escape": false
      },
      {
        "command": "/astro-help",
        "description": "Displays AstroBot NASA command center operations guide",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "incoming-webhook"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
