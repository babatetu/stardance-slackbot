# ===================================================
# AstroBot - Slack & NASA Configuration
# ===================================================

# Slack Bot User OAuth Token (starts with xoxb-)
# Found in: Slack API Portal -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack Signing Secret
# Found in: Slack API Portal -> Basic Information -> App Credentials
SLACK_SIGNING_SECRET=your-signing-secret

# Slack App-Level Token for Socket Mode (starts with xapp-)
# Found in: Slack API Portal -> Basic Information -> App-Level Tokens (Scope: connections:write)
SLACK_APP_TOKEN=xapp-your-app-level-token

# NASA Open API Key
# Get a free key at https://api.nasa.gov/ or leave as DEMO_KEY for initial testing
NASA_API_KEY=DEMO_KEY

# Optional: Server Port (if running in HTTP mode instead of Socket Mode)
PORT=3000
